[Unit]
Description=SonosCDPlayer GPIO buttons (command preview only)
After=local-fs.target
PartOf=sonoscdplayer.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/src/sonoscdplayer/src
ExecStart=/usr/bin/python3 -u -m integrations.interfaces.interface_input --config integrations/interfaces/interface.toml --gpio --commands
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s

# Auto-started by sonoscdplayer.target; preview only, no Sonos commands.
# Enable --execute only after controlled hardware acceptance.
