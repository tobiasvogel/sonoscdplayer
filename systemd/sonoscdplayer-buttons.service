#@ Template only: render with tools/render_runtime_units.py before installing.
[Unit]
Description=SonosCDPlayer GPIO buttons
After=local-fs.target
PartOf=sonoscdplayer.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@SONOSCDPLAYER_USER@
WorkingDirectory=@SONOSCDPLAYER_SRC@
ExecStart=/usr/bin/python3 -u -m integrations.interfaces.interface_input --config @SONOSCDPLAYER_INTERFACE_CONFIG@ --gpio --commands
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s

#@ Unrendered, this unit would only log button commands; the renderer
#@ enables the safe selected-target executor.
