#@ Template only: render with tools/render_runtime_units.py before installing.
[Unit]
Description=SonosCDPlayer CD / Sonos controller
After=local-fs.target
PartOf=sonoscdplayer.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=@SONOSCDPLAYER_USER@
WorkingDirectory=@SONOSCDPLAYER_SRC@
# systemd owns and cleans the private socket directory after a crash/stop.
RuntimeDirectory=sonoscdplayer
RuntimeDirectoryMode=0700
UMask=0077
# The installed SoCo dependency lives in the project venv, not system Python.
ExecStart=@SONOSCDPLAYER_PYTHON@ -u player_service.py --config @SONOSCDPLAYER_PLAYER_CONFIG@ --socket /run/sonoscdplayer/control.sock
# Do not automatically restart the Sonos owner until crash/ownership behavior is validated.
Restart=no
TimeoutStopSec=15

[Install]
WantedBy=sonoscdplayer.target
