#@ Template only: render with tools/render_runtime_units.py before installing.
[Unit]
Description=SonosCDPlayer OLED status frontend
# Stop order is reversed: on shutdown/reboot the OLED stops before the player,
# so it never shows "player unavailable" and its last frame stays until the
# shutdown screen takes over.
After=local-fs.target sonoscdplayer-player.service
PartOf=sonoscdplayer.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@SONOSCDPLAYER_USER@
WorkingDirectory=@SONOSCDPLAYER_SRC@
# Language chosen in the menu (ui.json); shared with the player's target.json.
StateDirectory=sonoscdplayer
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -u -m sonoscdplayer.ui.display_service --socket /run/sonoscdplayer/control.sock --gpio --execute --seconds 0
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s

[Install]
WantedBy=sonoscdplayer.target
