#@ Template only: render with tools/render_runtime_units.py before installing.
[Unit]
Description=SonosCDPlayer OLED status frontend
After=local-fs.target
PartOf=sonoscdplayer.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@SONOSCDPLAYER_USER@
WorkingDirectory=@SONOSCDPLAYER_SRC@
ExecStart=/usr/bin/python3 -u -m integrations.outputs.oled_status --socket /run/sonoscdplayer/control.sock --gpio --execute --seconds 0 --adopt-boot-splash --ambient-auto
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s

[Install]
WantedBy=sonoscdplayer.target
