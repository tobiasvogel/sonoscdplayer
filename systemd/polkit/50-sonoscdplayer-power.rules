// SonosCDPlayer: let the service user power the Raspberry Pi off or restart it.
//
// Template only: render it with
//   tools/render_runtime_units.py --service-user <account> ...
// and install the rendered copy (root) into /etc/polkit-1/rules.d/.
// Remove the file to revoke. Nothing else is granted: no suspend, no hibernate,
// no inhibitor override, no other users.
polkit.addRule(function(action, subject) {
    var allowed = [
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions"
    ];
    if (subject.user === "@SONOSCDPLAYER_USER@" && allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
