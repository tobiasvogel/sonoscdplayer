[Unit]
Description=SonosCDPlayer experimental OLED exitrd (RAM stage at boot)
Documentation=man:systemd.service(5)
After=local-fs.target
ConditionPathExists=/run/initramfs

[Service]
Type=oneshot
# Deliberately no RemainAfterExit/ExecStop: shutdown must NOT disarm this exitrd.
ExecStart=/usr/bin/python3 /usr/local/libexec/sonoscdplayer-exitrd/exitrd_autostage.py --config /home/pi/src/sonoscdplayer/src/config.toml --binary /usr/local/libexec/sonoscdplayer-exitrd/shutdown --sha-file /usr/local/libexec/sonoscdplayer-exitrd/shutdown.sha256
TimeoutStartSec=45
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
